# Copy this file to typesafe-bridge/.env and fill in your real key.
#   bash:        cp .env.example typesafe-bridge/.env
#   PowerShell:  Copy-Item .env.example typesafe-bridge/.env ; notepad typesafe-bridge\.env
#
# NEVER commit the real .env — it is git-ignored.
# Get a key at https://console.typesafe.ai/keys

# Required: your TypeSafe API key (starts with apikey_; ts_live_/ts_test_ also accepted).
TYPESAFE_API_KEY=apikey_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown):
#TYPESAFE_BRIDGE_PORT=8399
#BRIDGE_TOKEN=
#BRIDGE_ALLOWED_ORIGINS=
#BRIDGE_REDACT=
#BRIDGE_MAX_BODY_BYTES=2097152
#BRIDGE_MAX_STATE_CHARS=200000
#BRIDGE_LOG_LEVEL=info
#TYPESAFE_TIMEOUT_MS=60000
#TYPESAFE_API_BASE=https://api.typesafe.ai
