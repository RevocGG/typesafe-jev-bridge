# Secrets — never commit
.env
typesafe-bridge/.env
.env.*
!.env.example

# Private key material / credential files (also guarded at runtime)
*.pem
*.key
*.p12
*.pfx

# Local virtualenvs, logs, caches
.venv/
typesafe-bridge/.venv/
__pycache__/
node_modules/
coverage/
.DS_Store

# Private local AI-agent state (judgments, session data, etc.)
.freebuff/
.agents/skills/

# Tool outputs / leftovers
typesafe-bridge/answers*.json
*.bak-autofix*
*.log
nohup.out
.bridge.pid
